{
  "name": "shotkit",
  "version": "1.0.0",
  "private": true,
  "description": "ShotKit — capture a region or an element at true 1x–4x resolution, annotate it, save it.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node test-e2e/run.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "compare": "node scripts/compare-e2e.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "puppeteer": "^25.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
